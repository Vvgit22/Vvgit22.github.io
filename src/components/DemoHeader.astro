---
interface Props {
  backHref?: string;
  title: string;
  banner: string;
  tone?: 'amber' | 'blue' | 'green';
}

const { backHref = '/', title, banner, tone = 'amber' } = Astro.props;
const tones: Record<string, string> = {
  amber: 'border-amber-300 bg-amber-50 text-amber-900',
  blue: 'border-blue-300 bg-blue-50 text-blue-900',
  green: 'border-accent/40 bg-green-50 text-green-900',
};
---

<p class="mb-4 text-sm">
  <a href={backHref} class="text-accent underline-offset-2 hover:underline"
    >&larr; Back to project</a
  >
</p>
<h1 class="mb-2">{title}</h1>
<slot />
<div
  class:list={[
    'mb-10 rounded-lg border p-4 text-sm',
    tones[tone],
  ]}
>
  {banner}
</div>
