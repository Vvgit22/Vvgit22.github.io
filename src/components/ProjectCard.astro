---
import StatusChip from './StatusChip.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  status: 'live' | 'video' | 'in-progress' | 'upcoming' | 'card';
  statusLabel: string;
  tags: string[];
  thumbnail?: string;
}

const { slug, title, summary, status, statusLabel, tags, thumbnail } = Astro.props;
---

<a
  href={`/projects/${slug}/`}
  class="block rounded-lg border border-neutral-200 p-4 transition-colors hover:border-accent"
>
  {
    thumbnail && (
      <img
        src={thumbnail}
        alt=""
        width="720"
        height="405"
        loading="lazy"
        class="mb-3 w-full rounded"
      />
    )
  }
  <div class="mb-1 flex items-start justify-between gap-3">
    <h2 class="text-base font-semibold">{title}</h2>
    <StatusChip status={status} label={statusLabel} />
  </div>
  <p class="mb-3 text-sm text-neutral-600">{summary}</p>
  <ul class="flex flex-wrap gap-1.5">
    {
      tags.map((tag) => (
        <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">
          {tag}
        </li>
      ))
    }
  </ul>
</a>
