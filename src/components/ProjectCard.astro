---
import StatusChip from './StatusChip.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  status: 'live' | 'video' | 'in-progress' | 'upcoming' | 'card';
  statusLabel: string;
  tags: string[];
  thumbnail?: string;
}

const { slug, title, summary, status, statusLabel, tags, thumbnail } = Astro.props;
const shownTags = tags.slice(0, 4);
---

<a
  href={`/projects/${slug}/`}
  class="group block rounded-[10px] border border-neutral-200 p-4 transition-colors duration-150 hover:border-neutral-400"
>
  {
    thumbnail && (
      <div class="mb-3 aspect-[16/10] overflow-hidden rounded-[10px] border border-neutral-200">
        <img
          src={thumbnail}
          alt=""
          width="720"
          height="450"
          loading="lazy"
          class="h-full w-full object-cover transition-transform duration-150 group-hover:scale-[1.02]"
        />
      </div>
    )
  }
  <div class="mb-1 flex items-start justify-between gap-3">
    <h2 class="text-base font-semibold">{title}</h2>
    <StatusChip status={status} label={statusLabel} />
  </div>
  <p class="mb-3 line-clamp-2 text-sm text-neutral-600">{summary}</p>
  <ul class="flex flex-wrap gap-1.5">
    {
      shownTags.map((tag) => (
        <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">
          {tag}
        </li>
      ))
    }
  </ul>
</a>
