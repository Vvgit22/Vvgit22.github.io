---
interface Props {
  status: 'live' | 'video' | 'in-progress' | 'upcoming' | 'card';
  label: string;
}

const { status, label } = Astro.props;

const styles: Record<string, string> = {
  live: 'bg-green-100 text-green-900 border-green-300',
  video: 'bg-blue-100 text-blue-900 border-blue-300',
  'in-progress': 'bg-amber-100 text-amber-900 border-amber-300',
  upcoming: 'bg-transparent text-neutral-600 border-neutral-400',
  card: 'bg-neutral-200 text-neutral-700 border-neutral-300',
};
---

<span
  class:list={[
    'inline-block rounded-full border px-2.5 py-0.5 text-xs font-medium',
    styles[status],
  ]}
>
  {label}
</span>
