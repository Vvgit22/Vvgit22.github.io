---
import '../styles/global.css';
import { REPO_URL } from '../config';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Portfolio of Vadim Vadanici — software and analyses at the edge of engineering and medicine.', wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body class="bg-white text-neutral-900 antialiased">
    <main class:list={['mx-auto px-5 py-10', wide ? 'max-w-[960px]' : 'max-w-[68ch]']}>
      <slot />
      <footer
        class="mt-16 border-t border-neutral-200 pt-3 text-sm text-neutral-500"
      >
        <a
          href={REPO_URL}
          class="underline underline-offset-2 hover:text-neutral-800"
          >source on GitHub</a
        > · <a href="#" class="underline underline-offset-2 hover:text-neutral-800">back to top</a>
      </footer>
    </main>
  </body>
</html>
