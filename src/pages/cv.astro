---
import Base from '../layouts/Base.astro';
---

<Base title="CV — Vadim Vadanici">
  <p class="mb-6 text-sm">
    <a href="/" class="text-accent underline-offset-2 hover:underline"
      >&larr; Home</a
    >
  </p>
  <h1 class="mb-2 text-2xl font-bold">CV</h1>
  <p class="mb-6 text-neutral-600">
    Vadim Vadanici — MEng Biomedical Engineering (Computational
    Bioengineering), Imperial College London
  </p>
  <p class="mb-6">
    <a
      href="/cv/Vadim_Vadanici_CV.pdf"
      class="inline-block rounded-md bg-accent px-4 py-2 font-medium text-white hover:opacity-90"
      >Download CV (PDF)</a
    >
  </p>
  <object
    data="/cv/Vadim_Vadanici_CV.pdf"
    type="application/pdf"
    class="h-[1100px] w-full rounded-md border border-neutral-200"
  >
    <p class="text-sm text-neutral-600">
      Preview not available —
      <a
        href="/cv/Vadim_Vadanici_CV.pdf"
        class="text-accent underline-offset-2 hover:underline"
        >open the PDF</a
      >.
    </p>
  </object>
</Base>
