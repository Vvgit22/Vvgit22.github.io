---
import Base from '../layouts/Base.astro';
---

<Base title="CV — Vadim Vadanici">
  <p class="mb-6 text-sm">
    <a href="/" class="text-accent underline-offset-2 hover:underline"
      >&larr; Home</a
    >
  </p>
  <h1 class="mb-2 text-2xl font-bold">CV</h1>
  <p class="mb-6 text-neutral-600">
    Three variants of the same record. The Bio one is the main CV.
  </p>
  <ul class="space-y-3">
    <li>
      <a
        href="/cv/Vadim_Vadanici_CV_Bio.pdf"
        class="text-accent font-medium underline-offset-2 hover:underline"
        >Bio</a
      >
      <span class="text-neutral-600"> — biotech, neurotech, healthcare roles</span>
    </li>
    <li>
      <a
        href="/cv/Vadim_Vadanici_CV_AI.pdf"
        class="text-accent font-medium underline-offset-2 hover:underline"
        >AI</a
      >
      <span class="text-neutral-600"> — machine-learning and AI roles</span>
    </li>
    <li>
      <a
        href="/cv/Vadim_Vadanici_CV_Quant.pdf"
        class="text-accent font-medium underline-offset-2 hover:underline"
        >Quant</a
      >
      <span class="text-neutral-600">
         — quantitative finance and trading roles</span
      >
    </li>
  </ul>
</Base>
