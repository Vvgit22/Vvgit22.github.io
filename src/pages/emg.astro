---
import Base from '../layouts/Base.astro';
import DemoHeader from '../components/DemoHeader.astro';
import EmgResults from '../components/EmgResults.astro';
import results from '../data/emg-results.json';
import demoMeta from '../data/emg-demo.json';
import summary from '../data/emg-summary.json';
import timing from '../data/emg-timing.json';

// The interpretation paragraph below is approved prose with real numbers in
// it. Fail the build if the audit table drifts out of the ranges it cites.
const cells = results.cells as Record<
  string,
  Record<string, Record<string, { accuracy_mean: number }>>
>;
const cnnCS = cells.cnn.both.cross_subject.accuracy_mean * 100;
const ldaCS = cells.lda.both.cross_subject.accuracy_mean * 100;
// build-time sanity: every experiment id the page cites exists and every
// rendered percentage is a fraction in [0,1]
const benchExps = (demoMeta.benchmark?.experiments ?? {}) as
  Record<string, unknown>;
for (const id of ['causal_v1', 'offline_v1b', 'protocol_v1',
                  'protocol_v1_additions', 'protocol_v2'])
  if (!benchExps[id])
    throw new Error(`emg page: benchmark missing ${id}`);
const _chk = (x: number, where: string) => {
  if (!(x >= 0 && x <= 1)) throw new Error(`emg page: ${where}=${x} out of [0,1]`);
};
_chk(cells.cnn.both.cross_subject.accuracy_mean, 'cnn cs');
_chk(cells.lda.both.cross_subject.accuracy_mean, 'lda cs');
for (const k of ['seen', 'unseen'] as const) {
  _chk((demoMeta.models as any)[k].accuracy_on_demo_clips, `${k} demo acc`);
  _chk((demoMeta.models as any)[k].split_test_accuracy, `${k} test acc`);
}
const timingG = timing.group_delay_ms;

const m = demoMeta.models as Record<
  string,
  { accuracy_on_demo_clips: number; split_test_accuracy: number }
>;
const pct = (x: number) => (x * 100).toFixed(1);

// "Which gestures are hard" is rendered from the results JSON, not from
// pre-rendered figures, so every bar and cell is legible at page width.
const cs = (cells as any).cnn.both.cross_subject;
const f1Rows = demoMeta.classes
  .map((name, i) => ({ name, f1: cs.per_class_f1[i] }))
  .sort((a, b) => b.f1 - a.f1);
const worst3 = f1Rows.slice(-3);
const cm = cs.confusion as number[][];
const rowNorm = cm.map((row) => {
  const t = row.reduce((a, b) => a + b, 0);
  return row.map((v) => v / t);
});
let maxOff = { p: 0, t: 0, pr: 0 };
rowNorm.forEach((row, t) =>
  row.forEach((p, pr) => {
    if (t !== pr && p > maxOff.p) maxOff = { p, t, pr };
  }),
);
const windowRows = (['cnn_w64', 'cnn_w128', 'cnn'] as const).map((model) => ({
  label: { cnn: '250 ms', cnn_w128: '125 ms', cnn_w64: '62.5 ms' }[model],
  cd: (cells as any)[model].both.cross_day,
  cx: (cells as any)[model].both.cross_subject,
}));
const cnnWS = (cells as any).cnn.both.within_subject.accuracy_mean;
---

<Base
  title="EMG gesture decoder, live demo"
  description="Two small neural networks decoding 17 hand gestures from real held-out EMG recordings, running in your browser with ONNX Runtime."
>
  <DemoHeader
    backHref="/projects/emg-decoder/"
    title="EMG gesture decoder, live in your browser"
    banner="Real held-out recordings from the open GrabMyo dataset (subject 1, day 1, trial 6), used in training by neither model and run through the causal preprocessing chain a live stream would see. Both networks run in your browser with ONNX Runtime."
    tone="blue"
  />

  <section class="mb-12">
    <div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <button
        id="emg-play"
        class="rounded-lg bg-accent px-4 py-2 font-semibold text-white hover:bg-green-900 disabled:opacity-50"
        disabled
      >
        Play
      </button>
      <label class="flex items-center gap-2">
        Gesture
        <select id="emg-gesture" class="rounded border border-neutral-300 px-2 py-1" disabled>
          {demoMeta.classes.map((c, i) => <option value={i}>{c}</option>)}
        </select>
      </label>
      <label class="flex items-center gap-2">
        <input id="emg-playall" type="checkbox" checked disabled />
        Play all
      </label>
      <button
        id="emg-next"
        class="hidden rounded border border-neutral-300 px-3 py-1.5 disabled:opacity-50"
        disabled
      >
        Next window
      </button>
      <span id="emg-status" class="text-neutral-500">Loading recordings…</span>
      <button id="emg-retry" class="hidden rounded border border-neutral-300 px-3 py-1.5 text-sm">
        Retry
      </button>
      <span class="inline-flex min-h-4 min-w-40 gap-3 text-xs tabular-nums text-neutral-500">
        <span id="emg-skipped"></span><span id="emg-inf-time"></span>
      </span>
    </div>

    <canvas
      id="emg-canvas"
      class="h-[560px] w-full rounded-lg border border-neutral-200 bg-[#0b1020]"
      role="img"
      aria-label="Scrolling view of the 28 EMG channels; the highlighted band is the 250 ms window currently being classified."
    ></canvas>
    <p id="emg-announcer" class="sr-only" aria-live="polite"></p>

    <div class="mt-4 grid gap-4 sm:grid-cols-1 md:grid-cols-2">
      {
        (['seen', 'unseen'] as const).map((k) => (
          <div class="rounded-lg border border-neutral-200 p-4">
            <h2 class="mb-1 text-sm font-semibold" id={`emg-title-${k}`}>
              {k === 'seen'
                ? 'Model that trained on this person'
                : 'Model that never saw this person'}
            </h2>
            <p class="mb-2 text-xs text-neutral-500">
              {k === 'seen'
                ? 'within-subject split (seen.onnx)'
                : 'cross-subject fold (unseen.onnx)'}
            </p>
            <div id={`emg-grid-${k}`} class="mb-1 grid grid-cols-6 gap-1" />
            <p class="mb-2 text-[11px] text-neutral-500">
              outlined = true gesture, green = correct, red = wrong
            </p>
            <div id={`emg-bars-${k}`} class="mb-2 space-y-1" />
            <p id={`emg-tally-${k}`} class="text-xs tabular-nums text-neutral-600">
              correct windows: 0 / 0
            </p>
          </div>
        ))
      }
    </div>

    <p class="mt-3 text-sm text-neutral-600">
      On the 255 windows in these 17 clips, the model that trained on this
      person scores {pct(m.seen.accuracy_on_demo_clips)}% and the model that
      never saw them {pct(m.unseen.accuracy_on_demo_clips)}%; on their full
      held-out test sets, {pct(m.seen.split_test_accuracy)}% and
      {' '}{pct(m.unseen.split_test_accuracy)}%.
    </p>
    <p class="mt-2 text-sm text-neutral-600">
      Subject 1 was chosen as the demo person before any model was trained;
      on this one person the two models happen to land close together, while
      across all 43 people the gap is {pct(cnnWS)}% against
      {' '}{cnnCS.toFixed(1)}% (both figures are window-level fold means;
      the person-to-person spread is in the Robustness table).
    </p>
    <p id="emg-error" class="mt-2 hidden rounded border border-amber-300 bg-amber-50 p-3 text-sm text-amber-900">
      The in-browser runtime could not load; the results below are unaffected.
      <button id="emg-retry-2" class="ml-2 underline">Retry</button>
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Results</h2>
    <EmgResults />
    <p class="mt-6 max-w-prose text-sm leading-relaxed text-neutral-700">
      When the model already knows the person, a neural network buys nothing
      over a classical classifier: both sit at 93%. The harder the question,
      the more the network wins: +2 points on a new day, +12 points on a
      person it has never seen (68 → 80%). Hand-crafted features are tuned to
      one arm; learned features transfer. Wrist and forearm gestures are easy
      on strangers (91–96% F1); fine finger gestures are the hard part
      (63–68%), and the most frequent error, Hand Close read as a pinch grip,
      is the same for both models.
      Across three seeds and a causal preprocessing chain the unseen-person
      result stays between 79.5 and 81.3%.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Window length</h2>
    <table class="w-full max-w-md text-sm">
      <thead>
        <tr class="border-b border-neutral-200 text-left text-neutral-500">
          <th class="py-1 pr-4 font-medium">Window</th>
          <th class="py-1 pr-4 font-medium">cross-day</th>
          <th class="py-1 pr-4 font-medium">cross-subject</th>
        </tr>
      </thead>
      <tbody>
        {windowRows.map((r) => (
          <tr class="border-b border-neutral-100">
            <td class="py-1 pr-4">{r.label}</td>
            <td class="py-1 pr-4 tabular-nums">
              {pct(r.cd.accuracy_mean)} ± {(r.cd.accuracy_std * 100).toFixed(1)}
            </td>
            <td class="py-1 pr-4 tabular-nums">
              {pct(r.cx.accuracy_mean)} ± {(r.cx.accuracy_std * 100).toFixed(1)}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="mt-3 max-w-prose text-sm leading-relaxed text-neutral-700">
      Cutting the analysis window from 250 ms to 125 ms costs about a point
      and a half of accuracy; dropping to 62.5 ms costs three to six. Most of
      the gesture's information is in the first fraction of the contraction,
      but the tail still helps, and windows longer than 250 ms cannot be
      tested here because the recordings are only stored at that length.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Which gestures are hard</h2>
    <h3 class="mb-2 text-base font-semibold">Per-class F1, never-seen people</h3>
    <ul class="mb-8 max-w-2xl space-y-1">
      {f1Rows.map((r) => (
        <li class="flex items-center gap-3 text-sm">
          <span class="w-64 shrink-0">{r.name}</span>
          <span
            class="h-3 rounded bg-accent"
            style={`width:${(r.f1 * 300).toFixed(0)}px`}
          />
          <span class="ml-auto tabular-nums text-neutral-600">
            {(r.f1 * 100).toFixed(1)}%
          </span>
        </li>
      ))}
    </ul>
    <h3 class="mb-2 text-base font-semibold">Confusion matrix, never-seen people</h3>
    <div class="overflow-x-auto">
      <table class="border-collapse text-[10px]">
        <tbody>
          {rowNorm.map((row, t) => (
            <tr>
              <td class="whitespace-nowrap pr-2 text-right text-neutral-600">
                {demoMeta.classes[t]}
              </td>
              {row.map((p, pr) => (
                <td
                  class="h-6 w-6 border border-white text-center"
                  style={`background: rgb(22 101 52 / ${(0.08 + 0.92 * p).toFixed(3)})`}
                  title={`True ${demoMeta.classes[t]} -> predicted ${demoMeta.classes[pr]}: ${cm[t][pr]} windows (${(p * 100).toFixed(1)}%)`}
                  aria-label={`True ${demoMeta.classes[t]}, predicted ${demoMeta.classes[pr]}: ${(p * 100).toFixed(1)} percent`}
                >
                  {t === pr ? '' : p >= 0.05 ? Math.round(p * 100) : ''}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
      <p class="mt-1 text-xs text-neutral-500">
        Rows = true gesture, columns = predicted gesture, same order as the
        rows. Colour intensity = fraction of the true row.
      </p>
    </div>
    <p class="mt-4 max-w-prose text-sm leading-relaxed text-neutral-700">
      The three hardest gestures are
      {' '}{worst3.map((r) => `${r.name} (${(r.f1 * 100).toFixed(1)}%)`).join(', ')}.
      The single most frequent mistake is reading
      {' '}{demoMeta.classes[maxOff.t]} as {demoMeta.classes[maxOff.pr]}
      {' '}({(maxOff.p * 100).toFixed(1)}% of its windows).
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Timing</h2>
    <ul class="list-disc space-y-1 pl-5 text-sm text-neutral-700">
      <li>Analysis window 250 ms, hop 125 ms; causal filter group delay
        {timingG['50'].toFixed(1)}–{timingG['200'].toFixed(1)} ms
        (50–200 Hz); filter settling {timing.settle_s_1pct.toFixed(2)} s,
        under the dropped 0.5 s.</li>
      <li>Inference runs on the latest window every 125 ms of playback;
        measured browser time per window shown next to the controls; no
        smoothing between windows.</li>
      <li>This says nothing about latency to gesture onset; that would
        need onset-aligned data this dataset does not provide.</li>
      <li>The ONNX graphs contain per-channel normalisation and the
        network; the causal filter chain runs on the recording upstream,
        not in the graph.</li>
    </ul>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Robustness checks</h2>
    <table class="w-full max-w-2xl text-sm">
      <tbody>
        <tr class="border-b border-neutral-100">
          <td class="py-1 pr-4 font-medium">Seeds (offline control)</td>
          <td class="py-1 tabular-nums">79.5 / 80.8 / 80.4% — SD 0.64 pp</td>
        </tr>
        <tr class="border-b border-neutral-100">
          <td class="py-1 pr-4 font-medium">Causal vs offline preprocessing</td>
          <td class="py-1 tabular-nums">80.0% vs 79.5% (+0.41 pp paired)</td>
        </tr>
        <tr class="border-b border-neutral-100">
          <td class="py-1 pr-4 font-medium">Protocol v2 (re-drawn val subjects)</td>
          <td class="py-1 tabular-nums">80.7 ± 2.3%</td>
        </tr>
        <tr class="border-b border-neutral-100">
          <td class="py-1 pr-4 font-medium">Person-to-person spread (43)</td>
          <td class="py-1 tabular-nums">mean 80.0, SD 8.6 pp, worst 54.9%,
            5 of 43 below 70%</td>
        </tr>
        <tr class="border-b border-neutral-100">
          <td class="py-1 pr-4 font-medium">Calibration (temp. on val)</td>
          <td class="py-1 tabular-nums">ECE 8–13 pp → 2.5–7.2 pp; confidences
            shown in the panels are calibrated</td>
        </tr>
        <tr class="border-b border-neutral-100">
          <td class="py-1 pr-4 font-medium">Synthetic perturbations*</td>
          <td class="py-1 tabular-nums">1–2 dead channels −5/−11 pp;
            8 dead channels −45 pp; 0 dB noise −61 pp</td>
        </tr>
      </tbody>
    </table>
    <p class="mt-1 text-xs text-neutral-500">* controlled synthetic
      diagnostics, not evidence of real electrode re-donning robustness.</p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">How the data was split</h2>
    <ul class="max-w-prose list-disc space-y-2 pl-5 text-sm leading-relaxed text-neutral-700">
      <li>
        <strong>Within-subject</strong>: one person's repetitions 1–4 train
        the model, repetitions 6–7 test it, same day.
      </li>
      <li>
        <strong>Cross-day</strong>: days 1–2 train, day 3 tests, same person.
        the sensor has been taken off and put back on.
      </li>
      <li>
        <strong>Cross-subject</strong>: whole people are held out; the model
        is tested only on arms it has never seen.
      </li>
    </ul>
    <p class="mt-3 max-w-prose text-sm leading-relaxed text-neutral-700">
      Before every training run, a check asserts that no window's group, the
      same repetition, day or person, appears on both sides of the split;
      the same checks run as tests.
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Reproduce</h2>
    <pre class="overflow-x-auto rounded-lg bg-neutral-100 p-4 text-sm">uv sync
make download       # ~10 GB from the PhysioNet mirror
make windows        # build the windowed dataset
make reproduce      # features, LDA, CNN, figures (~45 min)
make reproduce-full # adds cross-subject sweeps and ablations</pre>
    <p class="mt-3 text-sm">
      <a
        href="https://github.com/Vvgit22/emg-gesture-decoder"
        class="text-accent underline-offset-2 hover:underline">Full pipeline on GitHub</a>
    </p>
  </section>

  <section class="mb-12">
    <h2 class="mb-4 text-xl font-semibold">Data</h2>
    <p class="max-w-prose text-sm leading-relaxed text-neutral-700">
      GrabMyo dataset, PhysioNet (doi:10.13026/89dm-f662), distributed under
      CC BY 4.0. Pradhan A, He J, Jiang N. <em>Multi-channel surface
      electromyography signals for hand gesture recognition.</em> Sci Data 9,
      733 (2022). doi:10.1038/s41597-022-01836-y. Pollard J, Gawlikowska A,
      et al. <em>Resources available in PhysioNet.</em> Nature Health (2026).
      doi:10.1038/s44360-026-00096-z.
    </p>
  </section>
</Base>

<script>
  // EMG live demo — small state machine.
  // States: idle -> loading -> ready | error. A single loadAll() promise
  // gates Play; a single rAF loop handle prevents duplicate loops.
  // Every clip yields exactly 15 inference windows (starts 0,128,...,1792);
  // a full Play-all cycle = 255 windows = the static metric's set.
  import demoMeta from '../data/emg-demo.json';

  const SEG = demoMeta.n_samples, WIN = demoMeta.window, STEP = demoMeta.step;
  const NG = demoMeta.n_gestures, NC = demoMeta.n_channels;
  const FOREARM = new Set(demoMeta.channels.forearm);
  const CLASSES = demoMeta.classes;
  const SCALE = demoMeta.scale;
  const TEMPS: Record<string, number> = {
    seen: demoMeta.models?.seen?.temperature ?? 1,
    unseen: demoMeta.models?.unseen?.temperature ?? 1,
  };

  const $ = (id: string) => document.getElementById(id) as any;
  const canvas = $('emg-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const statusEl = $('emg-status'), errEl = $('emg-error'),
    retryBtn = $('emg-retry');
  const playBtn = $('emg-play'), gestureSel = $('emg-gesture'),
    playAll = $('emg-playall'), nextBtn = $('emg-next');
  const announcer = $('emg-announcer');
  const skippedEl = $('emg-skipped');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  let state: 'idle' | 'loading' | 'ready' | 'error' = 'idle';
  let clips: Int16Array | null = null;
  let sessions: Record<string, any> | null = null;
  let ort: any = null;
  let playing = false, pos = 0, nextInfer = 0, lastAnnounce = 0;
  let generation = 0;             // stale-result guard
  let skipped = 0;
  let inferChain: Promise<void> = Promise.resolve();
  const inFlight: Record<string, boolean> = { seen: false, unseen: false };
  const tally: Record<string, { c: number; n: number }> = {
    seen: { c: 0, n: 0 }, unseen: { c: 0, n: 0 },
  };
  const lastPred: Record<string, number | null> = { seen: null, unseen: null };
  // test hooks (headless check only)
  const testState = {
    staleDiscarded: 0, loopCount: 0, inferCount: { seen: 0, unseen: 0 },
    calibratedMax: { seen: [] as number[], unseen: [] as number[] },
    argmax: { seen: [] as number[], unseen: [] as number[] },
    latencyMs: [] as number[],
  };
  let speed = 1;
  (window as any).__emg = {
    setSpeed: (n: number) => { speed = n; },
    test: testState,
    get generation() { return generation; },
    tally,
  };

  function clip(g: number, ch: number, s: number) {
    return clips![(g * NC + ch) * SEG + s] * SCALE;
  }
  function softmax(logits: Float32Array | number[], T = 1) {
    const mx = Math.max(...(logits as number[]));
    const e = Array.from(logits as number[], (v) => Math.exp(v / T - mx / T));
    const s = e.reduce((a, b) => a + b, 0);
    return e.map((v) => v / s);
  }

  function draw() {
    const dpr = window.devicePixelRatio || 1;
    const W = canvas.clientWidth, H = canvas.clientHeight;
    if (canvas.width !== W * dpr) { canvas.width = W * dpr; canvas.height = H * dpr; }
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.fillStyle = '#0b1020';
    ctx.fillRect(0, 0, W, H);
    if (!clips) {
      ctx.fillStyle = 'rgba(255,255,255,0.5)';
      ctx.font = '14px system-ui';
      ctx.textAlign = 'center';
      ctx.fillText('28 EMG channels; press Play to stream a recording',
                   W / 2, H / 2);
      return;
    }
    const g = Number(gestureSel.value);
    const rowH = H / NC;
    const x0 = ((pos - WIN) / SEG) * W, x1 = (pos / SEG) * W;
    ctx.fillStyle = 'rgba(255,255,255,0.08)';
    ctx.fillRect(Math.max(0, x0), 0, Math.max(0, x1 - x0), H);
    for (let ch = 0; ch < NC; ch++) {
      const y = rowH * (ch + 0.5);
      ctx.strokeStyle = FOREARM.has(ch) ? '#7cc7ff' : '#f0a35e';
      ctx.lineWidth = 1;
      ctx.beginPath();
      let mx = 1e-9;
      for (let s = 0; s < SEG; s += 4) mx = Math.max(mx, Math.abs(clip(g, ch, s)));
      for (let s = 0; s < SEG; s += 2) {
        const x = (s / SEG) * W;
        const v = clip(g, ch, s) / mx;
        s ? ctx.lineTo(x, y - v * rowH * 0.42) : ctx.moveTo(x, y - v * rowH * 0.42);
      }
      ctx.stroke();
    }
    const px = (pos / SEG) * W;
    ctx.strokeStyle = 'rgba(255,255,255,0.7)';
    ctx.beginPath(); ctx.moveTo(px, 0); ctx.lineTo(px, H); ctx.stroke();
  }

  function paintGrid(k: string, trueG: number, pred: number | null) {
    const grid = $(`emg-grid-${k}`);
    grid.innerHTML = '';
    for (let i = 0; i < NG; i++) {
      const cell = document.createElement('div');
      const isT = i === trueG, isP = i === pred;
      cell.className =
        'flex h-7 items-center justify-center rounded text-[10px] ' +
        (isP ? (isT ? 'bg-green-600 text-white ring-2 ring-neutral-800 ring-offset-1'
                    : 'bg-red-500 text-white')
             : isT ? 'border-2 border-accent'
                   : 'border border-neutral-300 text-neutral-600');
      cell.textContent = String(i + 1);
      cell.title = CLASSES[i];
      cell.setAttribute('aria-label', CLASSES[i]);
      grid.appendChild(cell);
    }
  }

  function paintBars(k: string, probsCal: number[] | null, rawMax: number | null) {
    const box = $(`emg-bars-${k}`);
    box.innerHTML = '';
    if (!probsCal) return;
    const top = probsCal.map((p, i) => [p, i] as const)
      .sort((a, b) => b[0] - a[0]).slice(0, 3);
    for (const [p, i] of top) {
      const row = document.createElement('div');
      row.className = 'flex items-center gap-2 text-xs';
      row.innerHTML =
        `<span class="w-40 truncate">${CLASSES[i]}</span>` +
        `<span class="h-2 rounded bg-accent" style="width:${(p * 140).toFixed(0)}px"></span>` +
        `<span class="tabular-nums text-neutral-500">${(p * 100).toFixed(0)}%</span>`;
      box.appendChild(row);
    }
    const note = document.createElement('div');
    note.className = 'mt-1 text-[11px] text-neutral-500';
    note.textContent =
      `calibrated confidence (softmax/T, T=${TEMPS[k].toFixed(2)})` +
      (rawMax != null ? `; raw softmax max: ${(rawMax * 100).toFixed(0)}%` : '');
    box.appendChild(note);
  }

  function paintTally(k: string) {
    const t = tally[k];
    $(`emg-tally-${k}`).textContent = `correct windows: ${t.c} / ${t.n}`;
  }
  function paintSkipped() {
    if (skippedEl) skippedEl.textContent = `windows skipped: ${skipped}`;
  }

  function windowAt(g: number, start: number) {
    const x = new Float32Array(NC * WIN);
    for (let ch = 0; ch < NC; ch++)
      for (let s = 0; s < WIN; s++)
        x[ch * WIN + s] = clip(g, ch, start + s);
    return x;
  }

  // Schedule one inference window for each model, bounded: at most one
  // in-flight inference per model; if playback outruns inference the
  // window is skipped and counted, never queued.
  function scheduleInfer(g: number, start: number, gen: number) {
    for (const k of ['seen', 'unseen'] as const) {
      if (inFlight[k]) { skipped++; paintSkipped(); continue; }
      inFlight[k] = true;
      testState.inferCount[k]++;
      const x = windowAt(g, start);
      const t0 = performance.now();
      // wasm sessions cannot run concurrently — serialise on one chain;
      // inFlight[k] bounds each model to one queued window
      inferChain = inferChain
        .then(() => sessions![k].run(
          { emg: new ort.Tensor('float32', x, [1, NC, WIN]) }))
        .then((out: any) => {
          const dt = performance.now() - t0;
          testState.latencyMs.push(dt);
          if (dtEl) {
            testState.latencyMs.sort((a, b) => a - b);
            dtEl.textContent = `inference ${testState.latencyMs[
              Math.floor(testState.latencyMs.length / 2)].toFixed(0)} ms/window (median)`;
          }
          if (gen !== generation) {
            testState.staleDiscarded++;           // late result for a stale context
            return;
          }
          const logits = Array.from(out.logits.data as Float32Array);
          const raw = softmax(logits, 1);
          const cal = softmax(logits, TEMPS[k]);
          const pred = raw.indexOf(Math.max(...raw));
          const calMax = Math.max(...cal);
          testState.argmax[k].push(pred);
          testState.calibratedMax[k].push(calMax);
          tally[k].n++; tally[k].c += pred === g ? 1 : 0;
          lastPred[k] = pred;
          paintGrid(k, g, pred); paintBars(k, cal, Math.max(...raw)); paintTally(k);
          const now = performance.now();
          if (now - lastAnnounce > 1000) {
            lastAnnounce = now;
            announcer.textContent =
              `True: ${CLASSES[g]}. ` +
              `Seen model: ${lastPred.seen == null ? 'pending' : CLASSES[lastPred.seen]}. ` +
              `Unseen model: ${lastPred.unseen == null ? 'pending' : CLASSES[lastPred.unseen]}.`;
          }
        })
        .catch((e: any) => { console.error('emg inference failed', e); })
        .finally(() => { inFlight[k] = false; });
    }
  }
  const dtEl = $('emg-inf-time');

  function advanceTo(npos: number) {
    pos = npos;
    const g = Number(gestureSel.value);
    if (pos >= SEG) {
      // drain this clip's remaining windows BEFORE advancing the gesture
      // (a fast cycle must still produce exactly 15 windows per clip)
      while (nextInfer <= SEG - WIN) {
        scheduleInfer(g, nextInfer, generation);
        nextInfer += STEP;
      }
      if (playAll.checked) {
        const ng = (g + 1) % NG;
        gestureSel.value = String(ng);
        // no generation++: the drained windows of the old clip are still
        // valid results; only manual changes interrupt
        pos -= SEG; nextInfer = 0;
        for (const k of ['seen', 'unseen'] as const) paintGrid(k, ng, null);
      } else { pos = SEG; pause(); }
    }
    // every clip yields exactly 15 windows at starts 0,128,...,1792
    while (nextInfer + WIN <= pos && nextInfer <= SEG - WIN) {
      scheduleInfer(g, nextInfer, generation);
      nextInfer += STEP;
    }
    draw();
  }

  function stepPlayback(dt: number) {
    advanceTo(pos + dt * 1024 * speed);
  }

  let raf = 0, lastT = 0;
  function loop(t: number) {
    if (!playing) return;
    const dt = Math.min(0.1, (t - lastT) / 1000); lastT = t;
    stepPlayback(dt);
    raf = requestAnimationFrame(loop);
  }
  function play() {
    if (!clips || !sessions) return;
    if (pos >= SEG) { pos = 0; nextInfer = 0; }
    playing = true; playBtn.textContent = 'Pause';
    cancelAnimationFrame(raf);      // never a second loop
    testState.loopCount++;
    lastT = performance.now();
    raf = requestAnimationFrame(loop);
  }
  function pause() {
    playing = false; playBtn.textContent = 'Play';
    cancelAnimationFrame(raf);
    generation++;                   // in-flight results become stale
  }
  function resetTally() {
    for (const k of ['seen', 'unseen'] as const) { tally[k] = { c: 0, n: 0 }; paintTally(k); }
  }

  gestureSel.addEventListener('change', () => {
    pos = 0; nextInfer = 0;
    generation++;                   // discard in-flight results
    if (!playAll.checked) resetTally();
    for (const k of ['seen', 'unseen'] as const)
      paintGrid(k, Number(gestureSel.value), null);
    draw();
  });
  playBtn.addEventListener('click', async () => {
    if (playing) { pause(); return; }
    if (state !== 'ready') { const ok = await loadAll(); if (!ok) return; }
    play();
  });
  nextBtn.addEventListener('click', async () => {
    if (state !== 'ready') { const ok = await loadAll(); if (!ok) return; }
    pos = Math.min(SEG, pos + STEP);
    while (nextInfer + WIN <= pos && nextInfer <= SEG - WIN) {
      scheduleInfer(Number(gestureSel.value), nextInfer, generation);
      nextInfer += STEP;
    }
    draw();
  });
  playAll.addEventListener('change', resetTally);
  retryBtn?.addEventListener('click', () => { loadAll(true); });
  $('emg-retry-2')?.addEventListener('click', () => { loadAll(true); });

  let loadPromise: Promise<boolean> | null = null;
  async function loadAll(force = false, clipsOnly = false): Promise<boolean> {
    if (state === 'ready' && !force && !clipsOnly) return true;
    if (loadPromise && !force) return loadPromise;
    loadPromise = (async () => {
      state = 'loading';
      statusEl.textContent = 'Loading recordings and models…';
      errEl.classList.add('hidden');
      try {
        if (!clips) {
          const [metaRes, binRes] = await Promise.all([
            fetch('/emg/demo.json'), fetch('/emg/demo.bin'),
          ]);
          if (!metaRes.ok || !binRes.ok) throw new Error('fetch failed');
          const meta = await metaRes.json();
          if (meta.scale !== SCALE) throw new Error('demo.json scale mismatch');
          clips = new Int16Array(await binRes.arrayBuffer());
        }
        if (!sessions && !clipsOnly) {
          ort = await import('onnxruntime-web');
          ort.env.wasm.wasmPaths = '/emg/ort/';
          ort.env.wasm.numThreads = 1;
          sessions = {};
          for (const k of ['seen', 'unseen'] as const)
            sessions[k] = await ort.InferenceSession.create(
              `/emg/models/${k}.onnx`, { executionProviders: ['wasm'] });
        }
        if (sessions) state = 'ready';
        else state = 'idle';
        statusEl.textContent = sessions ? 'Ready.' : 'Recordings ready; press Play to load models.';
        if (reduced) {
          nextBtn.classList.remove('hidden');
          nextBtn.disabled = false;
          pos = WIN; nextInfer = 0; draw();
        }
        for (const k of ['seen', 'unseen'] as const) paintGrid(k, 0, null);
        draw();
        return true;
      } catch (e) {
        console.error('emg demo load failed', e);
        state = 'error';
        statusEl.textContent = '';
        errEl.classList.remove('hidden');
        retryBtn?.classList.remove('hidden');
        return false;
      } finally {
        loadPromise = null;
      }
    })();
    return loadPromise;
  }

  for (const el of [playBtn, gestureSel, playAll]) el.disabled = false;
  if (reduced) {
    new IntersectionObserver((es, o) => {
      if (es.some((e) => e.isIntersecting)) {
        loadAll(false, true);   // clips only; models load on Next window
        o.disconnect();
      }
    }).observe(canvas);
  }
  draw();
</script>
