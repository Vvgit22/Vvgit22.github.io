---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { portrait } from '../lib/media';
import { GITHUB_URL } from '../config';

const portraitSrc = portrait();

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Vadim Vadanici" wide>
  <header class="mb-8">
    <div class="flex items-center gap-4">
      {portraitSrc && (
        <img
          src={portraitSrc}
          alt="Vadim Vadanici"
          width="96"
          height="96"
          class="h-24 w-24 rounded-full border border-neutral-200 object-cover"
        />
      )}
      <div>
        <h1 class="text-3xl font-bold">Vadim Vadanici</h1>
        <p class="mt-1 text-neutral-600">
          MEng Biomedical Engineering (Computational Bioengineering), Imperial
          College London · London, UK
        </p>
      </div>
    </div>
    <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      <a
        href={GITHUB_URL}
        class="text-accent underline-offset-2 hover:underline">GitHub</a
      >
      <a
        href="https://linkedin.com/in/vadim-vadanici"
        class="text-accent underline-offset-2 hover:underline">LinkedIn</a
      >
      <a
        href="mailto:vadim.vadanici24@imperial.ac.uk"
        class="text-accent underline-offset-2 hover:underline">Email</a
      >
      <a href="/cv/" class="text-accent underline-offset-2 hover:underline"
        >CV</a
      >
    </nav>
  </header>

  <p class="mb-10 leading-relaxed">
    Hi, I'm Vadim, a third-year bioengineer at Imperial. I'm fascinated by
    mathematics and what it can do in healthcare and neurotech, and I love
    building software that turns an idea into something people can actually
    use. Below are my projects. Most of them run right here in the browser,
    so have a look around.
  </p>

  <h2 class="mb-3 text-[0.75rem] font-medium uppercase tracking-[0.08em] text-neutral-500">
    Projects
  </h2>
  <section class="grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      projects.map((p) => (
        <ProjectCard
          slug={p.id}
          title={p.data.title}
          summary={p.data.summary}
          status={p.data.status}
          statusLabel={p.data.statusLabel}
          tags={p.data.tags}
          thumbnail={p.data.thumbnail}
        />
      ))
    }
  </section>

</Base>
