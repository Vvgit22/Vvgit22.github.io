---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<Base title="Vadim Vadanici">
  <header class="mb-8">
    <h1 class="text-3xl font-bold">Vadim Vadanici</h1>
    <p class="mt-1 text-neutral-600">
      MEng Biomedical Engineering (Computational Bioengineering), Imperial
      College London · London, UK
    </p>
    <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
      <a
        href="https://github.com/Vvgit22"
        class="text-accent underline-offset-2 hover:underline">GitHub</a
      >
      <a
        href="https://linkedin.com/in/vadim-vadanici"
        class="text-accent underline-offset-2 hover:underline">LinkedIn</a
      >
      <a
        href="mailto:vadim.vadanici24@imperial.ac.uk"
        class="text-accent underline-offset-2 hover:underline">Email</a
      >
      <a href="/cv/" class="text-accent underline-offset-2 hover:underline"
        >CV</a
      >
    </nav>
  </header>

  <p class="mb-10 leading-relaxed">
    I build software and run analyses at the edge of engineering and medicine:
    machine learning on EMG and fMRI signals, an LLM pipeline for
    kidney-transplant patients' free-text responses, a gamified physiotherapy
    system with Bluetooth wristbands, and a job-search engine with a provenance
    guard that stops the model from inventing a claim. Everything below is
    either something you can try in the browser, a recording of it running, or
    an honest note on what is still in progress.
  </p>

  <section class="grid gap-4 sm:grid-cols-2">
    {
      projects.map((p) => (
        <ProjectCard
          slug={p.id}
          title={p.data.title}
          summary={p.data.summary}
          status={p.data.status}
          statusLabel={p.data.statusLabel}
          tags={p.data.tags}
          thumbnail={p.data.thumbnail}
        />
      ))
    }
  </section>

  <section class="mt-8 rounded-lg border border-dashed border-neutral-300 p-4">
    <p class="text-sm text-neutral-600">
      <span class="font-medium text-neutral-800">Upcoming, 2026–27</span> —
      Interpretability of multimodal vision-language models for clinical
      hypothesis generation in oncology, supervised by Prof Guang Yang
      (Imperial). Not started; no claims yet.
    </p>
  </section>

  <footer class="mt-12 border-t border-neutral-200 pt-4 text-sm text-neutral-500">
    Built with Astro · hosted on GitHub Pages ·
    <a
      href="https://github.com/Vvgit22/Vvgit22.github.io"
      class="underline underline-offset-2 hover:text-neutral-800"
      >source on GitHub</a
    >
  </footer>
</Base>
