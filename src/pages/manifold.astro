---
import Base from '../layouts/Base.astro';
---

<Base
  title="Neural manifolds — synthetic illustration"
  description="A browser-side illustration of low-dimensional structure in high-dimensional activity, on fully synthetic data."
>
  <p class="mb-4 text-sm">
    <a href="/projects/neural-manifolds/" class="text-accent underline-offset-2 hover:underline"
      >&larr; Back to project</a
    >
  </p>

  <h1 class="mb-3 text-2xl font-bold">A neural manifold, illustrated</h1>
  <div class="mb-5 rounded-lg border border-blue-300 bg-blue-50 p-4 text-sm text-blue-900">
    Illustration on synthetic data generated in your browser. No PREVENT
    Dementia data and no Schultz Lab results are shown.
  </div>

  <div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
    <label class="flex items-center gap-1.5">
      <input type="checkbox" id="autorotate" checked /> auto-rotate
    </label>
    <label class="flex items-center gap-1.5">
      <input type="checkbox" id="unroll" /> unroll
    </label>
    <label class="flex items-center gap-1.5">
      <input type="checkbox" id="pca" /> show PCA axes
    </label>
    <label class="flex items-center gap-2">
      noise
      <input type="range" id="noise" min="0" max="1.5" step="0.05" value="0.4" class="w-32" />
      <span id="noise-val" class="w-8 text-neutral-600">0.40</span>
    </label>
    <span class="text-xs text-neutral-500">drag to rotate</span>
  </div>

  <canvas
    id="cv"
    width="900"
    height="620"
    class="w-full rounded border border-neutral-200 bg-white"
    aria-label="Interactive 3-D point cloud of a synthetic Swiss-roll manifold"
    role="img"></canvas>

  <div class="mt-5 space-y-3 text-sm leading-relaxed text-neutral-700">
    <p>
      A neural manifold is the idea that a large population of neurons — a very
      high-dimensional signal — often varies along only a few underlying
      directions, so the activity traces out a low-dimensional surface inside
      the high-dimensional space. Here a 2-D sheet is rolled into 3-D, like a
      Swiss roll: each point is coloured by its position along the roll.
    </p>
    <p>
      The PCA axes show the best linear description of the cloud — three
      straight directions of greatest variance. Toggling "unroll" flattens the
      sheet back to its true 2-D coordinates, which no straight line can
      recover: that is the structure linear methods miss and manifold methods
      look for.
    </p>
    <p>
      Brain-imaging work asks the same question of real data: does activity in
      a network like the default-mode network live on a low-dimensional
      manifold, and does that manifold change with age?
    </p>
  </div>

  <script>
    const canvas = document.getElementById('cv') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const W = canvas.width;
    const H = canvas.height;
    const N = 1500;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // seeded PRNG (mulberry32)
    let seed = 0x9e3779b9;
    function rand() {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }
    function gauss() {
      const u = Math.max(rand(), 1e-9);
      const v = rand();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    // viridis-like stops
    const stops: [number, [number, number, number]][] = [
      [0, [68, 1, 84]],
      [0.25, [59, 82, 139]],
      [0.5, [33, 145, 140]],
      [0.75, [94, 201, 98]],
      [1, [253, 231, 37]],
    ];
    function colorFor(t: number): string {
      let i = 0;
      while (i < stops.length - 2 && t > stops[i + 1][0]) i++;
      const [t0, c0] = stops[i];
      const [t1, c1] = stops[i + 1];
      const f = (t - t0) / (t1 - t0);
      const c = c0.map((a, k) => Math.round(a + (c1[k] - a) * f));
      return `rgb(${c[0]},${c[1]},${c[2]})`;
    }

    // intrinsic coords + 3-D embedding (Swiss roll)
    const pts: {
      t: number; h: number;            // intrinsic
      x: number; y: number; z: number; // 3-D (noise applied separately)
      nx: number; ny: number; nz: number; // noise direction stored as offset per unit sigma
      color: string;
      sx: number; sy: number; // screen
    }[] = [];
    for (let i = 0; i < N; i++) {
      const t = 1.5 * Math.PI + rand() * 3 * Math.PI;
      const h = rand() * 20;
      pts.push({
        t, h,
        x: t * Math.cos(t),
        y: h - 10,
        z: t * Math.sin(t),
        nx: gauss(), ny: gauss(), nz: gauss(),
        color: colorFor((t - 1.5 * Math.PI) / (3 * Math.PI)),
        sx: 0, sy: 0,
      });
    }

    let noiseSigma = 0.4;
    let yaw = 0.6;
    let pitch = -0.35;
    let unrollT = 0; // 0 rolled, 1 unrolled
    let unrollTarget = 0;
    const startUnrolled = location.hash === '#unrolled';
    if (startUnrolled) {
      unrollTarget = 1;
      unrollT = 1;
    }
    let autoRotate = !reduced;
    let showPCA = false;

    const autorotateEl = document.getElementById('autorotate') as HTMLInputElement;
    const unrollEl = document.getElementById('unroll') as HTMLInputElement;
    const pcaEl = document.getElementById('pca') as HTMLInputElement;
    const noiseEl = document.getElementById('noise') as HTMLInputElement;
    const noiseVal = document.getElementById('noise-val')!;
    autorotateEl.checked = autoRotate;
    unrollEl.checked = startUnrolled;

    autorotateEl.addEventListener('change', () => (autoRotate = autorotateEl.checked));
    unrollEl.addEventListener('change', () => (unrollTarget = unrollEl.checked ? 1 : 0));
    pcaEl.addEventListener('change', () => (showPCA = pcaEl.checked));
    noiseEl.addEventListener('input', () => {
      noiseSigma = Number(noiseEl.value);
      noiseVal.textContent = noiseSigma.toFixed(2);
    });

    // drag rotate
    let dragging = false;
    let lx = 0, ly = 0;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lx = e.clientX;
      ly = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      yaw += (e.clientX - lx) * 0.008;
      pitch += (e.clientY - ly) * 0.008;
      pitch = Math.max(-1.5, Math.min(1.5, pitch));
      lx = e.clientX;
      ly = e.clientY;
    });
    canvas.addEventListener('pointerup', () => (dragging = false));
    canvas.addEventListener('pointercancel', () => (dragging = false));

    // ease
    function ease(u: number) {
      return u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;
    }

    // PCA via Jacobi eigen decomposition of 3x3 covariance (recomputed per frame's current coords — cheap: 1500 pts)
    function pcaAxes(m: number[][]): { v: number[][]; e: number[] } {
      const cov = [[0,0,0],[0,0,0],[0,0,0]];
      const mean = [0, 0, 0];
      for (const p of m) { mean[0]+=p[0]; mean[1]+=p[1]; mean[2]+=p[2]; }
      mean[0]/=N; mean[1]/=N; mean[2]/=N;
      for (const p of m) {
        const dx=p[0]-mean[0], dy=p[1]-mean[1], dz=p[2]-mean[2];
        cov[0][0]+=dx*dx; cov[0][1]+=dx*dy; cov[0][2]+=dx*dz;
        cov[1][1]+=dy*dy; cov[1][2]+=dy*dz; cov[2][2]+=dz*dz;
      }
      cov[1][0]=cov[0][1]; cov[2][0]=cov[0][2]; cov[2][1]=cov[1][2];
      for (let i=0;i<3;i++) for(let j=0;j<3;j++) cov[i][j]/=N;
      // Jacobi
      const a = cov.map(r=>[...r]);
      const v = [[1,0,0],[0,1,0],[0,0,1]];
      for (let iter=0; iter<30; iter++) {
        let pi=0, pj=1, mx=Math.abs(a[0][1]);
        if (Math.abs(a[0][2])>mx){mx=Math.abs(a[0][2]);pi=0;pj=2;}
        if (Math.abs(a[1][2])>mx){mx=Math.abs(a[1][2]);pi=1;pj=2;}
        if (mx<1e-10) break;
        const theta=0.5*Math.atan2(2*a[pi][pj], a[pj][pj]-a[pi][pi]);
        const c=Math.cos(theta), s=Math.sin(theta);
        for (let k=0;k<3;k++){
          const aik=a[k][pi], ajk=a[k][pj];
          a[k][pi]=c*aik-s*ajk; a[k][pj]=s*aik+c*ajk;
        }
        for (let k=0;k<3;k++){
          const aik=a[pi][k], ajk=a[pj][k];
          a[pi][k]=c*aik-s*ajk; a[pj][k]=s*aik+c*ajk;
        }
        for (let k=0;k<3;k++){
          const vik=v[k][pi], vjk=v[k][pj];
          v[k][pi]=c*vik-s*vjk; v[k][pj]=s*vik+c*vjk;
        }
      }
      const e=[a[0][0],a[1][1],a[2][2]];
      // sort desc
      const idx=[0,1,2].sort((i,j)=>e[j]-e[i]);
      return { v: idx.map(i=>[v[0][i],v[1][i],v[2][i]]), e: idx.map(i=>Math.sqrt(Math.max(e[i],0))) };
    }

    let last = performance.now();
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (autoRotate && !dragging) yaw += dt * 0.35;
      const speed = dt / 1.2;
      if (unrollT < unrollTarget) unrollT = Math.min(unrollTarget, unrollT + speed);
      else if (unrollT > unrollTarget) unrollT = Math.max(unrollTarget, unrollT - speed);
      const u = ease(unrollT);

      // current coords
      const coords: number[][] = new Array(N);
      // unrolled target: lay flat (t, h) scaled to similar extent
      for (let i = 0; i < N; i++) {
        const p = pts[i];
        const rx = p.x + p.nx * noiseSigma;
        const ry = p.y + p.ny * noiseSigma;
        const rz = p.z + p.nz * noiseSigma;
        const ux = (p.t - 3 * Math.PI) * 2.2;
        const uy = p.h - 10;
        const uz = 0;
        coords[i] = [
          rx + (ux - rx) * u,
          ry + (uy - ry) * u,
          rz + (uz - rz) * u,
        ];
      }

      // center
      let cx = 0, cy = 0, cz = 0;
      for (const c of coords) { cx += c[0]; cy += c[1]; cz += c[2]; }
      cx /= N; cy /= N; cz /= N;

      const sy = Math.sin(yaw), cyw = Math.cos(yaw);
      const sp = Math.sin(pitch), cp = Math.cos(pitch);
      const fov = 700;
      const scale = 26;

      function project(x: number, y: number, z: number): [number, number, number] {
        const dx = x - cx, dy = y - cy, dz = z - cz;
        const x1 = dx * cyw - dz * sy;
        const z1 = dx * sy + dz * cyw;
        const y1 = dy * cp - z1 * sp;
        const z2 = dy * sp + z1 * cp;
        const d = 90;
        const s = fov / (d + z2 * scale * 0.06);
        return [W / 2 + x1 * scale * s * 0.09, H / 2 + y1 * scale * s * 0.09, z2];
      }

      ctx.clearRect(0, 0, W, H);

      // PCA axes
      if (showPCA) {
        const { v, e } = pcaAxes(coords);
        const origin = project(cx, cy, cz);
        const axisColors = ['#dc2626', '#2563eb', '#16a34a'];
        for (let k = 0; k < 3; k++) {
          const len = e[k] * 2.2;
          const end = project(
            cx + v[k][0] * len,
            cy + v[k][1] * len,
            cz + v[k][2] * len,
          );
          ctx.strokeStyle = axisColors[k];
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(origin[0], origin[1]);
          ctx.lineTo(end[0], end[1]);
          ctx.stroke();
        }
      }

      // points: sort by depth for painter order
      const order = coords.map((c, i) => i);
      const depths = coords.map((c) => project(c[0], c[1], c[2])[2]);
      order.sort((a, b) => depths[a] - depths[b]);
      for (const i of order) {
        const p = pts[i];
        const [sx, sy2, z] = project(coords[i][0], coords[i][1], coords[i][2]);
        const r = Math.max(1.2, 2.4 - z * 0.02);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(sx, sy2, r, 0, 6.2832);
        ctx.fill();
      }

      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  </script>
</Base>
