---
import Base from '../layouts/Base.astro';
import DemoHeader from '../components/DemoHeader.astro';
---

<Base
  title="Neural manifolds — synthetic illustration"
  description="A browser-side illustration of low-dimensional structure in high-dimensional activity, on fully synthetic data."
>
  <DemoHeader
    backHref="/projects/neural-manifolds/"
    title="A neural manifold, illustrated"
    banner="Illustration on synthetic data generated in your browser — simulated fMRI-like signals, not real brain data. No PREVENT Dementia data and no Schultz Lab results are shown."
    tone="blue"
  />

  <section class="mb-12">
    <div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
      <button
        id="fm-play"
        class="rounded border border-neutral-300 px-3 py-1 hover:bg-neutral-100"
        >pause</button
      >
      <label class="flex items-center gap-2">
        noise σ
        <input type="range" id="fm-noise" min="0" max="1" step="0.05" value="0.3" class="w-28" />
        <span id="fm-noise-val" class="w-8 text-neutral-600">0.30</span>
      </label>
      <label class="flex items-center gap-2">
        regions
        <select id="fm-regions" class="rounded border border-neutral-300 px-1 py-0.5">
          <option value="16">16</option>
          <option value="48" selected>48</option>
          <option value="96">96</option>
        </select>
      </label>
      <label class="flex items-center gap-1.5">
        <input type="checkbox" id="fm-latent3" /> third latent oscillator
      </label>
      <span class="text-xs text-neutral-500">drag the right panel to rotate</span>
    </div>

    <div class="flex flex-col gap-4 md:flex-row">
      <div class="md:w-[45%]">
        <canvas
          id="fm-heat"
          width="420"
          height="360"
          class="w-full rounded border border-neutral-200 bg-white"
          aria-label="Heat-map of 48 simulated region time series"
          role="img"></canvas>
        <p class="mt-1 text-xs text-neutral-500" id="fm-heat-cap">
          48 simulated regions × 300 TRs (TR = 2 s)
        </p>
      </div>
      <div class="md:w-[55%]">
        <canvas
          id="fm-traj"
          width="500"
          height="360"
          class="w-full rounded border border-neutral-200 bg-white"
          aria-label="PCA trajectory of the simulated region signals in 3-D"
          role="img"></canvas>
        <p class="mt-1 text-xs text-neutral-500" id="fm-var">
          variance explained: —</p
        >
      </div>
    </div>

    <div class="mt-4 space-y-2 text-sm leading-relaxed text-neutral-700">
      <p>
        The heat-map shows one simulated time series per region: two (or three)
        slow latent oscillators, mixed differently into each region, passed
        through a soft nonlinearity, with noise and a slow drift added.
      </p>
      <p>
        Although there are 48 signals, the right panel keeps only their three
        strongest shared directions (PCA): the activity still traces a tight
        loop, because the regions are not independent — they all read the same
        few latent variables. Raise the noise and the explained variance drops;
        the shape unravels.
      </p>
      <p>
        In the real project the equivalent question is asked of PREVENT
        Dementia fMRI with MIMI (a mutual-information method) rather than PCA —
        no results are implied here.
      </p>
    </div>
  </section>

  <h2 class="mb-2 text-lg font-semibold">A rolled sheet in 3-D</h2>
  <div class="mb-3 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm">
    <label class="flex items-center gap-1.5">
      <input type="checkbox" id="autorotate" checked /> auto-rotate
    </label>
    <label class="flex items-center gap-1.5">
      <input type="checkbox" id="unroll" /> unroll
    </label>
    <label class="flex items-center gap-1.5">
      <input type="checkbox" id="pca" /> show PCA axes
    </label>
    <label class="flex items-center gap-2">
      noise
      <input type="range" id="noise" min="0" max="1.5" step="0.05" value="0.4" class="w-32" />
      <span id="noise-val" class="w-8 text-neutral-600">0.40</span>
    </label>
    <span class="text-xs text-neutral-500">drag to rotate</span>
  </div>

  <canvas
    id="cv"
    width="900"
    height="620"
    class="w-full rounded border border-neutral-200 bg-white"
    aria-label="Interactive 3-D point cloud of a synthetic Swiss-roll manifold"
    role="img"></canvas>

  <div class="mt-5 space-y-3 text-sm leading-relaxed text-neutral-700">
    <p>
      A neural manifold is the idea that a large population of neurons — a very
      high-dimensional signal — often varies along only a few underlying
      directions, so the activity traces out a low-dimensional surface inside
      the high-dimensional space. Here a 2-D sheet is rolled into 3-D, like a
      Swiss roll: each point is coloured by its position along the roll.
    </p>
    <p>
      The PCA axes show the best linear description of the cloud — three
      straight directions of greatest variance. Toggling "unroll" flattens the
      sheet back to its true 2-D coordinates, which no straight line can
      recover: that is the structure linear methods miss and manifold methods
      look for.
    </p>
    <p>
      Brain-imaging work asks the same question of real data: does activity in
      a network like the default-mode network live on a low-dimensional
      manifold, and does that manifold change with age?
    </p>
  </div>

  <script>
    // ---- simulated fMRI → low-dimensional trajectory -----------------------
    const heatCv = document.getElementById('fm-heat') as HTMLCanvasElement;
    const trajCv = document.getElementById('fm-traj') as HTMLCanvasElement;
    const hctx = heatCv.getContext('2d')!;
    const tctx = trajCv.getContext('2d')!;
    const reducedFM = matchMedia('(prefers-reduced-motion: reduce)').matches;

    const T = 300, TR = 2;
    let fmSeed = 0x51ed1e;
    function fmRand() {
      fmSeed |= 0;
      fmSeed = (fmSeed + 0x6d2b79f5) | 0;
      let t = Math.imul(fmSeed ^ (fmSeed >>> 15), 1 | fmSeed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }
    function fmGauss() {
      const u = Math.max(fmRand(), 1e-9);
      const v = fmRand();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    // diverging blue-white-red
    function divColor(v: number): [number, number, number] {
      const t = Math.max(-1, Math.min(1, v));
      const lerp = (a: number[], b: number[], f: number) =>
        a.map((x, i) => x + (b[i] - x) * f);
      const c = t < 0
        ? lerp([33, 102, 172], [247, 247, 247], 1 + t)
        : lerp([247, 247, 247], [178, 24, 43], t);
      return [c[0] | 0, c[1] | 0, c[2] | 0];
    }

    // Jacobi eigendecomposition of a symmetric n×n matrix
    function jacobi(m: number[][]): { vals: number[]; vecs: number[][] } {
      const n = m.length;
      const a = m.map(r => [...r]);
      const v: number[][] = Array.from({ length: n }, (_, i) =>
        Array.from({ length: n }, (_, j) => (i === j ? 1 : 0)));
      for (let it = 0; it < 60; it++) {
        let pi = 0, pj = 1, mx = 0;
        for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) {
          if (Math.abs(a[i][j]) > mx) { mx = Math.abs(a[i][j]); pi = i; pj = j; }
        }
        if (mx < 1e-12) break;
        const th = 0.5 * Math.atan2(2 * a[pi][pj], a[pj][pj] - a[pi][pi]);
        const c = Math.cos(th), s = Math.sin(th);
        for (let k = 0; k < n; k++) {
          const x = a[k][pi], y = a[k][pj];
          a[k][pi] = c * x - s * y; a[k][pj] = s * x + c * y;
        }
        for (let k = 0; k < n; k++) {
          const x = a[pi][k], y = a[pj][k];
          a[pi][k] = c * x - s * y; a[pj][k] = s * x + c * y;
        }
        for (let k = 0; k < n; k++) {
          const x = v[k][pi], y = v[k][pj];
          v[k][pi] = c * x - s * y; v[k][pj] = s * x + c * y;
        }
      }
      const idx = Array.from({ length: n }, (_, i) => i).sort(
        (i, j) => a[j][j] - a[i][i]);
      return {
        vals: idx.map(i => Math.max(a[i][i], 0)),
        vecs: idx.map(i => v.map(row => row[i])),
      };
    }

    interface FM {
      X: Float32Array[];        // T × R centred data
      heat: ImageData;          // pre-rendered heat-map
      traj: number[][];         // T × 3 PCA scores
      varpct: number[];         // top-3 explained %
      R: number;
    }

    let nRegions = 48, latent3 = false, noiseSigma = 0.3;
    let fm: FM;
    let cur = 0, playing = !reducedFM, acc = 0;

    function buildFM() {
      fmSeed = 0x51ed1e;
      const R = nRegions;
      // latent oscillators: ~40 s, ~65 s (and ~110 s when toggled)
      const periods = latent3 ? [20, 32.5, 55] : [20, 32.5]; // in TRs (2 s)
      const L = periods.map(p =>
        Array.from({ length: T }, (_, t) => Math.sin(2 * Math.PI * t / p + p)));
      // per-region weights, nonlinearity, noise, drift
      const w: number[][] = [];
      const dr: number[] = [];
      for (let r = 0; r < R; r++) {
        w.push(periods.map(() => fmGauss()));
        dr.push((fmRand() - 0.5) * 0.004);
      }
      const noise: number[][] = [];
      for (let r = 0; r < R; r++) {
        const row: number[] = [];
        for (let t = 0; t < T; t++) row.push(fmGauss());
        noise.push(row);
      }
      const X: Float32Array[] = [];
      for (let t = 0; t < T; t++) {
        const row = new Float32Array(R);
        for (let r = 0; r < R; r++) {
          let z = 0;
          for (let k = 0; k < periods.length; k++) z += w[r][k] * L[k][t];
          row[r] = Math.tanh(z) + noiseSigma * noise[r][t] + dr[r] * t;
        }
        X.push(row);
      }
      // centre columns
      for (let r = 0; r < R; r++) {
        let m = 0;
        for (let t = 0; t < T; t++) m += X[t][r];
        m /= T;
        for (let t = 0; t < T; t++) X[t][r] -= m;
      }
      // R×R covariance → top-3 PCs
      const cov: number[][] = Array.from({ length: R }, () => new Array(R).fill(0));
      for (let i = 0; i < R; i++) for (let j = i; j < R; j++) {
        let s = 0;
        for (let t = 0; t < T; t++) s += X[t][i] * X[t][j];
        cov[i][j] = cov[j][i] = s / T;
      }
      const { vals, vecs } = jacobi(cov);
      const totVar = vals.reduce((a, b) => a + b, 0) || 1;
      const varpct = [0, 1, 2].map(k => 100 * vals[k] / totVar);
      const traj: number[][] = [];
      for (let t = 0; t < T; t++) {
        traj.push([0, 1, 2].map(k => {
          let s = 0;
          for (let r = 0; r < R; r++) s += X[t][r] * vecs[k][r];
          return s;
        }));
      }
      // pre-render heat-map pixels
      const heat = hctx.createImageData(T, R);
      let mx = 1e-9;
      for (let t = 0; t < T; t++) for (let r = 0; r < R; r++)
        mx = Math.max(mx, Math.abs(X[t][r]));
      for (let t = 0; t < T; t++) for (let r = 0; r < R; r++) {
        const [cr, cg, cb] = divColor(X[t][r] / mx);
        const o = (r * T + t) * 4;
        heat.data[o] = cr; heat.data[o + 1] = cg; heat.data[o + 2] = cb;
        heat.data[o + 3] = 255;
      }
      fm = { X, heat, traj, varpct, R };
      heatOff.width = T;
      heatOff.height = R;
      hOffCtx.putImageData(heat, 0, 0);
      document.getElementById('fm-var')!.textContent =
        `variance explained: PC1 ${varpct[0].toFixed(0)}% · ` +
        `PC2 ${varpct[1].toFixed(0)}% · PC3 ${varpct[2].toFixed(0)}%`;
      document.getElementById('fm-heat-cap')!.textContent =
        `${R} simulated regions × ${T} TRs (TR = ${TR} s)`;
    }

    // offscreen canvas for the heat-map so scaling is one drawImage
    const heatOff = document.createElement('canvas');
    const hOffCtx = heatOff.getContext('2d')!;

    let yawF = 0.7, pitchF = -0.3, dragF = false, lxF = 0, lyF = 0;
    trajCv.addEventListener('pointerdown', e => {
      dragF = true; lxF = e.clientX; lyF = e.clientY;
      trajCv.setPointerCapture(e.pointerId);
    });
    trajCv.addEventListener('pointermove', e => {
      if (!dragF) return;
      yawF += (e.clientX - lxF) * 0.008;
      pitchF = Math.max(-1.5, Math.min(1.5, pitchF + (e.clientY - lyF) * 0.008));
      lxF = e.clientX; lyF = e.clientY;
    });
    trajCv.addEventListener('pointerup', () => (dragF = false));
    trajCv.addEventListener('pointercancel', () => (dragF = false));

    const playBtn = document.getElementById('fm-play') as HTMLButtonElement;
    playBtn.textContent = playing ? 'pause' : 'play';
    playBtn.addEventListener('click', () => {
      playing = !playing;
      playBtn.textContent = playing ? 'pause' : 'play';
    });
    const noiseEl = document.getElementById('fm-noise') as HTMLInputElement;
    const noiseVal = document.getElementById('fm-noise-val')!;
    noiseEl.addEventListener('input', () => {
      noiseSigma = Number(noiseEl.value);
      noiseVal.textContent = noiseSigma.toFixed(2);
      buildFM();
    });
    (document.getElementById('fm-regions') as HTMLSelectElement)
      .addEventListener('change', e => {
        nRegions = Number((e.target as HTMLSelectElement).value);
        buildFM();
      });
    (document.getElementById('fm-latent3') as HTMLInputElement)
      .addEventListener('change', e => {
        latent3 = (e.target as HTMLInputElement).checked;
        buildFM();
      });

    const SPEED = 20; // TRs per second of playback
    let lastFM = performance.now();
    function fmFrame(now: number) {
      const dt = Math.min((now - lastFM) / 1000, 0.1);
      lastFM = now;
      if (playing) {
        acc += dt * SPEED;
        if (acc >= 1) { cur = (cur + Math.floor(acc)) % T; acc %= 1; }
      }
      const { traj, R } = fm!;
      const W1 = heatCv.width, H1 = heatCv.height;
      const W2 = trajCv.width, H2 = trajCv.height;

      // heat-map
      hctx.clearRect(0, 0, W1, H1);
      const labelW = 26;
      hctx.imageSmoothingEnabled = false;
      hctx.drawImage(heatOff, labelW, 0, W1 - labelW, H1);
      // row labels (up to 16 labels)
      hctx.fillStyle = '#5b6470';
      hctx.font = '8px ui-monospace, monospace';
      const step = Math.max(1, Math.ceil(R / 12));
      for (let r = 0; r < R; r += step) {
        hctx.fillText(
          'R' + String(r + 1).padStart(2, '0'),
          1, (r + 0.7) * H1 / R);
      }
      // cursor
      const cxp = labelW + (cur + 0.5) * (W1 - labelW) / T;
      hctx.strokeStyle = '#111';
      hctx.lineWidth = 1.5;
      hctx.beginPath();
      hctx.moveTo(cxp, 0); hctx.lineTo(cxp, H1); hctx.stroke();

      // trajectory
      tctx.clearRect(0, 0, W2, H2);
      let mx2 = 1e-9;
      for (const p of traj) for (const c of p) mx2 = Math.max(mx2, Math.abs(c));
      const sc = 0.42 * Math.min(W2, H2) / mx2;
      const syw = Math.sin(yawF), cyw = Math.cos(yawF);
      const sp = Math.sin(pitchF), cp = Math.cos(pitchF);
      const proj = (p: number[]): [number, number] => {
        const [x, y, z] = p;
        const x1 = x * cyw - z * syw, z1 = x * syw + z * cyw;
        const y1 = y * cp - z1 * sp, z2 = y * sp + z1 * cp;
        const s = 300 / (300 + z2 * sc * 0.12);
        return [W2 / 2 + x1 * sc * s, H2 / 2 + y1 * sc * s];
      };
      // faint full path
      tctx.strokeStyle = 'rgba(140,150,160,.45)';
      tctx.lineWidth = 1;
      tctx.beginPath();
      for (let t = 0; t < T; t++) {
        const [a, b] = proj(traj[t]);
        t ? tctx.lineTo(a, b) : tctx.moveTo(a, b);
      }
      tctx.stroke();
      // fading trail toward current point
      const TRAIL = 90;
      for (let k = TRAIL; k > 0; k--) {
        const t1 = (cur - k + T) % T, t2 = (cur - k + 1 + T) % T;
        const [a, b] = proj(traj[t1]);
        const [c, d] = proj(traj[t2]);
        tctx.strokeStyle = `rgba(14,107,61,${0.15 + 0.85 * (1 - k / TRAIL)})`;
        tctx.lineWidth = 2;
        tctx.beginPath(); tctx.moveTo(a, b); tctx.lineTo(c, d); tctx.stroke();
      }
      // current dot
      const [dx, dy] = proj(traj[cur]);
      tctx.fillStyle = '#0e6b3d';
      tctx.beginPath(); tctx.arc(dx, dy, 4.5, 0, 6.2832); tctx.fill();
      tctx.fillStyle = '#fff';
      tctx.beginPath(); tctx.arc(dx, dy, 1.8, 0, 6.2832); tctx.fill();

      requestAnimationFrame(fmFrame);
    }
    buildFM();
    requestAnimationFrame(fmFrame);
  </script>

  <script>
    const canvas = document.getElementById('cv') as HTMLCanvasElement;
    const ctx = canvas.getContext('2d')!;
    const W = canvas.width;
    const H = canvas.height;
    const N = 1500;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // seeded PRNG (mulberry32)
    let seed = 0x9e3779b9;
    function rand() {
      seed |= 0;
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    }
    function gauss() {
      const u = Math.max(rand(), 1e-9);
      const v = rand();
      return Math.sqrt(-2 * Math.log(u)) * Math.cos(2 * Math.PI * v);
    }

    // viridis-like stops
    const stops: [number, [number, number, number]][] = [
      [0, [68, 1, 84]],
      [0.25, [59, 82, 139]],
      [0.5, [33, 145, 140]],
      [0.75, [94, 201, 98]],
      [1, [253, 231, 37]],
    ];
    function colorFor(t: number): string {
      let i = 0;
      while (i < stops.length - 2 && t > stops[i + 1][0]) i++;
      const [t0, c0] = stops[i];
      const [t1, c1] = stops[i + 1];
      const f = (t - t0) / (t1 - t0);
      const c = c0.map((a, k) => Math.round(a + (c1[k] - a) * f));
      return `rgb(${c[0]},${c[1]},${c[2]})`;
    }

    // intrinsic coords + 3-D embedding (Swiss roll)
    const pts: {
      t: number; h: number;            // intrinsic
      x: number; y: number; z: number; // 3-D (noise applied separately)
      nx: number; ny: number; nz: number; // noise direction stored as offset per unit sigma
      color: string;
      sx: number; sy: number; // screen
    }[] = [];
    for (let i = 0; i < N; i++) {
      const t = 1.5 * Math.PI + rand() * 3 * Math.PI;
      const h = rand() * 20;
      pts.push({
        t, h,
        x: t * Math.cos(t),
        y: h - 10,
        z: t * Math.sin(t),
        nx: gauss(), ny: gauss(), nz: gauss(),
        color: colorFor((t - 1.5 * Math.PI) / (3 * Math.PI)),
        sx: 0, sy: 0,
      });
    }

    let noiseSigma = 0.4;
    let yaw = 0.6;
    let pitch = -0.35;
    let unrollT = 0; // 0 rolled, 1 unrolled
    let unrollTarget = 0;
    const startUnrolled = location.hash === '#unrolled';
    if (startUnrolled) {
      unrollTarget = 1;
      unrollT = 1;
    }
    let autoRotate = !reduced;
    let showPCA = false;

    const autorotateEl = document.getElementById('autorotate') as HTMLInputElement;
    const unrollEl = document.getElementById('unroll') as HTMLInputElement;
    const pcaEl = document.getElementById('pca') as HTMLInputElement;
    const noiseEl = document.getElementById('noise') as HTMLInputElement;
    const noiseVal = document.getElementById('noise-val')!;
    autorotateEl.checked = autoRotate;
    unrollEl.checked = startUnrolled;

    autorotateEl.addEventListener('change', () => (autoRotate = autorotateEl.checked));
    unrollEl.addEventListener('change', () => (unrollTarget = unrollEl.checked ? 1 : 0));
    pcaEl.addEventListener('change', () => (showPCA = pcaEl.checked));
    noiseEl.addEventListener('input', () => {
      noiseSigma = Number(noiseEl.value);
      noiseVal.textContent = noiseSigma.toFixed(2);
    });

    // drag rotate
    let dragging = false;
    let lx = 0, ly = 0;
    canvas.addEventListener('pointerdown', (e) => {
      dragging = true;
      lx = e.clientX;
      ly = e.clientY;
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      yaw += (e.clientX - lx) * 0.008;
      pitch += (e.clientY - ly) * 0.008;
      pitch = Math.max(-1.5, Math.min(1.5, pitch));
      lx = e.clientX;
      ly = e.clientY;
    });
    canvas.addEventListener('pointerup', () => (dragging = false));
    canvas.addEventListener('pointercancel', () => (dragging = false));

    // ease
    function ease(u: number) {
      return u < 0.5 ? 4 * u * u * u : 1 - Math.pow(-2 * u + 2, 3) / 2;
    }

    // PCA via Jacobi eigen decomposition of 3x3 covariance (recomputed per frame's current coords — cheap: 1500 pts)
    function pcaAxes(m: number[][]): { v: number[][]; e: number[] } {
      const cov = [[0,0,0],[0,0,0],[0,0,0]];
      const mean = [0, 0, 0];
      for (const p of m) { mean[0]+=p[0]; mean[1]+=p[1]; mean[2]+=p[2]; }
      mean[0]/=N; mean[1]/=N; mean[2]/=N;
      for (const p of m) {
        const dx=p[0]-mean[0], dy=p[1]-mean[1], dz=p[2]-mean[2];
        cov[0][0]+=dx*dx; cov[0][1]+=dx*dy; cov[0][2]+=dx*dz;
        cov[1][1]+=dy*dy; cov[1][2]+=dy*dz; cov[2][2]+=dz*dz;
      }
      cov[1][0]=cov[0][1]; cov[2][0]=cov[0][2]; cov[2][1]=cov[1][2];
      for (let i=0;i<3;i++) for(let j=0;j<3;j++) cov[i][j]/=N;
      // Jacobi
      const a = cov.map(r=>[...r]);
      const v = [[1,0,0],[0,1,0],[0,0,1]];
      for (let iter=0; iter<30; iter++) {
        let pi=0, pj=1, mx=Math.abs(a[0][1]);
        if (Math.abs(a[0][2])>mx){mx=Math.abs(a[0][2]);pi=0;pj=2;}
        if (Math.abs(a[1][2])>mx){mx=Math.abs(a[1][2]);pi=1;pj=2;}
        if (mx<1e-10) break;
        const theta=0.5*Math.atan2(2*a[pi][pj], a[pj][pj]-a[pi][pi]);
        const c=Math.cos(theta), s=Math.sin(theta);
        for (let k=0;k<3;k++){
          const aik=a[k][pi], ajk=a[k][pj];
          a[k][pi]=c*aik-s*ajk; a[k][pj]=s*aik+c*ajk;
        }
        for (let k=0;k<3;k++){
          const aik=a[pi][k], ajk=a[pj][k];
          a[pi][k]=c*aik-s*ajk; a[pj][k]=s*aik+c*ajk;
        }
        for (let k=0;k<3;k++){
          const vik=v[k][pi], vjk=v[k][pj];
          v[k][pi]=c*vik-s*vjk; v[k][pj]=s*vik+c*vjk;
        }
      }
      const e=[a[0][0],a[1][1],a[2][2]];
      // sort desc
      const idx=[0,1,2].sort((i,j)=>e[j]-e[i]);
      return { v: idx.map(i=>[v[0][i],v[1][i],v[2][i]]), e: idx.map(i=>Math.sqrt(Math.max(e[i],0))) };
    }

    let last = performance.now();
    function frame(now: number) {
      const dt = Math.min((now - last) / 1000, 0.05);
      last = now;
      if (autoRotate && !dragging) yaw += dt * 0.35;
      const speed = dt / 1.2;
      if (unrollT < unrollTarget) unrollT = Math.min(unrollTarget, unrollT + speed);
      else if (unrollT > unrollTarget) unrollT = Math.max(unrollTarget, unrollT - speed);
      const u = ease(unrollT);

      // current coords
      const coords: number[][] = new Array(N);
      // unrolled target: lay flat (t, h) scaled to similar extent
      for (let i = 0; i < N; i++) {
        const p = pts[i];
        const rx = p.x + p.nx * noiseSigma;
        const ry = p.y + p.ny * noiseSigma;
        const rz = p.z + p.nz * noiseSigma;
        const ux = (p.t - 3 * Math.PI) * 2.2;
        const uy = p.h - 10;
        const uz = 0;
        coords[i] = [
          rx + (ux - rx) * u,
          ry + (uy - ry) * u,
          rz + (uz - rz) * u,
        ];
      }

      // center
      let cx = 0, cy = 0, cz = 0;
      for (const c of coords) { cx += c[0]; cy += c[1]; cz += c[2]; }
      cx /= N; cy /= N; cz /= N;

      const sy = Math.sin(yaw), cyw = Math.cos(yaw);
      const sp = Math.sin(pitch), cp = Math.cos(pitch);
      const fov = 700;
      const scale = 26;

      function project(x: number, y: number, z: number): [number, number, number] {
        const dx = x - cx, dy = y - cy, dz = z - cz;
        const x1 = dx * cyw - dz * sy;
        const z1 = dx * sy + dz * cyw;
        const y1 = dy * cp - z1 * sp;
        const z2 = dy * sp + z1 * cp;
        const d = 90;
        const s = fov / (d + z2 * scale * 0.06);
        return [W / 2 + x1 * scale * s * 0.09, H / 2 + y1 * scale * s * 0.09, z2];
      }

      ctx.clearRect(0, 0, W, H);

      // PCA axes
      if (showPCA) {
        const { v, e } = pcaAxes(coords);
        const origin = project(cx, cy, cz);
        const axisColors = ['#dc2626', '#2563eb', '#16a34a'];
        for (let k = 0; k < 3; k++) {
          const len = e[k] * 2.2;
          const end = project(
            cx + v[k][0] * len,
            cy + v[k][1] * len,
            cz + v[k][2] * len,
          );
          ctx.strokeStyle = axisColors[k];
          ctx.lineWidth = 3;
          ctx.beginPath();
          ctx.moveTo(origin[0], origin[1]);
          ctx.lineTo(end[0], end[1]);
          ctx.stroke();
        }
      }

      // points: sort by depth for painter order
      const order = coords.map((c, i) => i);
      const depths = coords.map((c) => project(c[0], c[1], c[2])[2]);
      order.sort((a, b) => depths[a] - depths[b]);
      for (const i of order) {
        const p = pts[i];
        const [sx, sy2, z] = project(coords[i][0], coords[i][1], coords[i][2]);
        const r = Math.max(1.2, 2.4 - z * 0.02);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(sx, sy2, r, 0, 6.2832);
        ctx.fill();
      }

      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  </script>
</Base>
