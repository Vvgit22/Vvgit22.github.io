---
import { getCollection, render } from 'astro:content';

import Base from '../../layouts/Base.astro';
import StatusChip from '../../components/StatusChip.astro';
import Video from '../../components/Video.astro';
import JobOsArchitecture from '../../components/JobOsArchitecture.astro';
import { mediaExists, requestPhotos } from '../../lib/media';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const hasDemo = Boolean(data.links?.demo);
const isJobOs = project.id === 'job-os';
const demoPending =
  !hasDemo && !isJobOs && (data.status === 'live' || data.status === 'video');
const jobOsVideoExists = isJobOs && mediaExists('job-os-demo.mp4');
const isRequest = project.id === 'request';
const requestVideoExists = isRequest && mediaExists('request-game.mp4');
const requestPhotoList = isRequest ? requestPhotos() : [];
const extras = data.links?.more ?? [];
---

<Base title={`${data.title} — Vadim Vadanici`} description={data.summary}>
  <p class="mb-6 text-sm">
    <a href="/" class="text-accent underline-offset-2 hover:underline"
      >&larr; All projects</a
    >
  </p>

  <header class="mb-8">
    <div class="mb-2 flex items-start justify-between gap-3">
      <h1 class="text-2xl font-bold">{data.title}</h1>
      <StatusChip status={data.status} label={data.statusLabel} />
    </div>
    <dl class="grid gap-x-8 gap-y-1 text-sm text-neutral-600 sm:grid-cols-2">
      <div><dt class="inline font-medium text-neutral-800">Period: </dt><dd class="inline">{data.period}</dd></div>
      <div><dt class="inline font-medium text-neutral-800">Role: </dt><dd class="inline">{data.role}</dd></div>
      {data.team && (
        <div><dt class="inline font-medium text-neutral-800">Team: </dt><dd class="inline">{data.team}</dd></div>
      )}
    </dl>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {data.tags.map((tag) => (
        <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">{tag}</li>
      ))}
    </ul>
  </header>

  {(data.links?.repo || data.links?.demo || data.links?.video || extras.length > 0 || hasDemo) && (
    <div class="mb-8 flex flex-wrap items-center gap-x-5 gap-y-2">
      {hasDemo && (
        <a
          href={data.links!.demo}
          class="inline-block rounded-lg bg-accent px-5 py-2.5 font-semibold text-white hover:bg-green-900"
        >
          Open the demo &rarr;
        </a>
      )}
      <nav class="flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {data.links?.repo && (
          <a href={data.links.repo} class="text-accent underline-offset-2 hover:underline">Repository</a>
        )}
        {data.links?.video && (
          <a href={data.links.video} class="text-accent underline-offset-2 hover:underline">Video</a>
        )}
        {extras.map((l) => (
          <a href={l.url} class="text-accent underline-offset-2 hover:underline">{l.label}</a>
        ))}
      </nav>
    </div>
  )}

  {demoPending && (
    <div class="mb-8 rounded-lg border border-dashed border-neutral-300 bg-neutral-50 p-6 text-center text-sm text-neutral-600">
      Demo in preparation.
    </div>
  )}

  {project.id === 'request' && hasDemo && (
    <section class="mb-8">
      <p class="mb-2 text-sm text-neutral-600">
        Demo login included; data resets on refresh.{' '}
        <a href="/request/" class="text-accent underline-offset-2 hover:underline">
          Open full screen
        </a>
      </p>
      <iframe
        src="/request/"
        loading="lazy"
        title="ReQuest prototype"
        class="h-[760px] w-full rounded-lg border border-neutral-300"
      />
    </section>
  )}

  <article class="prose-body">
    <Content />
  </article>

  {requestVideoExists && (
    <section class="mb-8">
      <h2 class="mb-3 mt-8 text-lg font-semibold">The game</h2>
      <Video
        src="/media/request-game.mp4"
        poster={
          mediaExists('request-game-poster.webp')
            ? '/media/request-game-poster.webp'
            : undefined
        }
        title="ReQuest game"
        caption="The pygame dungeon driven by the wristbands over Bluetooth."
      />
    </section>
  )}

  {requestPhotoList.length > 0 && (
    <section class="mb-8">
      <h2 class="mb-3 mt-8 text-lg font-semibold">Hardware</h2>
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-3">
        {requestPhotoList.map((src) => (
          <img
            src={src}
            alt="ReQuest wristband hardware"
            loading="lazy"
            class="w-full rounded-lg border border-neutral-200 object-cover"
          />
        ))}
      </div>
    </section>
  )}

  {isJobOs && (
    <section class="mb-8">
      <h2 class="mb-3 mt-8 text-lg font-semibold">Recording</h2>
      {jobOsVideoExists ? (
        <Video
          src="/media/job-os-demo.mp4"
          poster="/media/job-os-demo-poster.webp"
          title="Job OS demo"
          caption="Walkthrough on a seeded demo database with fictional postings."
        />
      ) : (
        <div class="rounded-lg border border-dashed border-neutral-300 bg-neutral-50 p-6 text-center text-sm text-neutral-600">
          Recording in preparation.
        </div>
      )}
      <div class="mt-8">
        <JobOsArchitecture />
      </div>
    </section>
  )}
</Base>
