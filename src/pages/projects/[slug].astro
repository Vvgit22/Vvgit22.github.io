---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import Base from '../../layouts/Base.astro';
import StatusChip from '../../components/StatusChip.astro';
import Video from '../../components/Video.astro';
import JobOsArchitecture from '../../components/JobOsArchitecture.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project);

const hasDemo = Boolean(data.links?.demo);
const isJobOs = project.id === 'job-os';
const demoPending =
  !hasDemo && !isJobOs && (data.status === 'live' || data.status === 'video');
const jobOsVideoExists = isJobOs
  ? existsSync(
      fileURLToPath(
        new URL('../../../public/media/job-os-demo.mp4', import.meta.url),
      ),
    )
  : false;
---

<Base title={`${data.title} — Vadim Vadanici`} description={data.summary}>
  <p class="mb-6 text-sm">
    <a href="/" class="text-accent underline-offset-2 hover:underline"
      >&larr; All projects</a
    >
  </p>

  <header class="mb-8">
    <div class="mb-2 flex items-start justify-between gap-3">
      <h1 class="text-2xl font-bold">{data.title}</h1>
      <StatusChip status={data.status} label={data.statusLabel} />
    </div>
    <dl class="text-sm text-neutral-600">
      <div class="mt-1"><dt class="inline font-medium text-neutral-800">Period: </dt><dd class="inline">{data.period}</dd></div>
      <div class="mt-1"><dt class="inline font-medium text-neutral-800">Role: </dt><dd class="inline">{data.role}</dd></div>
      {data.team && (
        <div class="mt-1"><dt class="inline font-medium text-neutral-800">Team: </dt><dd class="inline">{data.team}</dd></div>
      )}
    </dl>
    <ul class="mt-3 flex flex-wrap gap-1.5">
      {data.tags.map((tag) => (
        <li class="rounded bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">{tag}</li>
      ))}
    </ul>
    {(data.links?.repo || data.links?.demo || data.links?.video) && (
      <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm">
        {data.links.repo && (
          <a href={data.links.repo} class="text-accent underline-offset-2 hover:underline">Repository</a>
        )}
        {data.links.demo && (
          <a href={data.links.demo} class="text-accent underline-offset-2 hover:underline">Demo</a>
        )}
        {data.links.video && (
          <a href={data.links.video} class="text-accent underline-offset-2 hover:underline">Video</a>
        )}
      </nav>
    )}
  </header>

  {hasDemo && (
    <a
      href={data.links!.demo}
      class="mb-8 inline-block rounded-lg bg-accent px-5 py-2.5 font-semibold text-white hover:bg-green-900"
    >
      Open the demo &rarr;
    </a>
  )}

  {isJobOs && (
    <section class="mb-8">
      {jobOsVideoExists ? (
        <Video
          src="/media/job-os-demo.mp4"
          poster="/media/job-os-demo-poster.webp"
          title="Job OS demo"
          caption="Job OS walkthrough — seeded data, no real applications."
        />
      ) : (
        <div class="rounded-lg border border-dashed border-neutral-300 bg-neutral-50 p-6 text-center text-sm text-neutral-600">
          Recording coming soon.
        </div>
      )}
      <div class="mt-8">
        <JobOsArchitecture />
      </div>
    </section>
  )}

  {demoPending && (
    <div class="mb-8 rounded-lg border border-dashed border-neutral-300 bg-neutral-50 p-6 text-center text-sm text-neutral-600">
      Demo coming to this page.
    </div>
  )}

  {project.id === 'request' && hasDemo && (
    <section class="mb-8">
      <p class="mb-2 text-sm text-neutral-600">
        Demo login inside; data is in-memory and resets on refresh.{' '}
        <a href="/request/" class="text-accent underline-offset-2 hover:underline">
          Open full screen
        </a>
      </p>
      <iframe
        src="/request/"
        loading="lazy"
        title="ReQuest prototype"
        class="h-[760px] w-full rounded-lg border border-neutral-300"
      />
    </section>
  )}

  <article class="prose-portfolio">
    <Content />
  </article>
</Base>

<style>
  .prose-portfolio h2 {
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
  }
  .prose-portfolio p {
    margin-bottom: 0.75rem;
    line-height: 1.65;
    color: var(--color-neutral-700);
  }
</style>
